# Team Chitrak recruitment — server-side environment variables.
# Copy these placeholders into Vercel → Project → Settings → Environment Variables.
# Never commit real credentials. Never expose these to frontend code.

# Google service account (Editor access to the recruitment spreadsheet only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=chitrak-recruitment@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
GOOGLE_SHEET_TAB=Responses

# Optional: distributed rate limiting, idempotency and identity locks across
# serverless instances.
# Strongly recommended for production. Works with any Upstash Redis REST database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: extra allowed origins, comma-separated. Same-origin requests are
# always allowed, so this is only needed for a separate preview/custom domain.
RECRUITMENT_ALLOWED_ORIGINS=

# Optional rate limits for VALID submissions.
RECRUITMENT_RATE_LIMIT_PER_HOUR=8
RECRUITMENT_RATE_LIMIT_PER_DAY=3
